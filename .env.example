# Environment mode (production, development)
ENVIRONMENT=development

# Application ports and URLs
PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=sqlite:///./tensor_lens.db

# Authentication (Keycloak OIDC)
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/tensor-lens
OIDC_CLIENT_ID=tensor-lens-client
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=tensor-lens-client

# Local demo mode (refused when ENVIRONMENT=production)
DEMO_MODE=true

# Optional LLM Advisory Configuration (LLM_API_KEY is the only secret)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
